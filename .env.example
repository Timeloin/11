# MongoDB Connection String (from MongoDB Atlas)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/inventory_app?retryWrites=true&w=majority

# JWT Secret for Auth sessions
JWT_SECRET=super-secret-inventory-token-key-2026

# Application URL
NEXT_PUBLIC_APP_URL=https://your-inventory-app.vercel.app
